# ===================== LedgerGift Mini App =====================
# Скопируй этот файл в .env и заполни своими значениями.

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО поменяй, если старый был засвечен!)
BOT_TOKEN=123456789:PUT-YOUR-FRESH-TOKEN-HERE

# Юзернейм бота без @ (нужно для deep-link ссылок на сделки)
BOT_USERNAME=LedgerGiftBot

# Публичный HTTPS-адрес, где развёрнут Mini App (без слэша в конце)
# Например: https://ledgergift.yourdomain.com
WEBAPP_URL=https://your-domain.example

# ID администраторов через запятую. Только они видят команду /admin и админ-панель.
ADMIN_IDS=8706790108

# ID владельца (может добавлять новых админов). Оставь пустым = первый из ADMIN_IDS.
OWNER_ID=8706790108

# Контакт поддержки/менеджера (без @)
SUPPORT_USERNAME=LedgerManagerGift

# Ссылка для пополнения баланса (её можно менять и из админ-панели)
PAYMENT_URL=https://t.me/LedgerManagerGift

# Хост и порт веб-сервера (оставь как есть для локального запуска)
HOST=127.0.0.1
PORT=8080
